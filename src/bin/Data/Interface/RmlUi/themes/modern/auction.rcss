/* Modern theme for CAuctionWindow: docked_panel_frame.rcss's forged panel (linked first), the tabs
   and arrows as modern buttons (the open tab in the accent), the list on a recessed well, locked
   buttons dimmed. Geometry is the legacy one (reference px under the dock transform). */

#panel { pointer-events: auto; }

.sharp-text { display: block; position: absolute; white-space: nowrap; text-align: center; pointer-events: none; }

#title { left: 15px; top: 13px; font-weight: bold; color: token(text-warm); }

.au-btn {
	display: block;
	position: absolute;
	background-color: token(surface-raised);
	border: 1px token(border-frame);
	border-radius: token(radius-sm)px;
	pointer-events: auto;
}
.au-btn:hover { border-color: token(accent-steel-hover); }
.btn-label { left: 0; color: token(text-primary); }
.au-btn.locked, .au-btn.locked:hover { background-color: token(surface-recessed); border-color: token(border-frame); }
.au-btn.locked .btn-label { color: token(text-muted); }

.tab { top: 38px; width: 53px; height: 22px; }
.tab.selected, .tab.selected:hover { border-color: token(accent-steel-hover); background-color: token(surface-recessed); }
.tab.selected .btn-label { color: token(accent-gold); }
#tab_buy { left: 10px; }
#tab_mine { left: 68px; }
#tab_sell { left: 126px; }

.selector { display: block; position: absolute; top: 66px; width: 86px; height: 18px; }
#kind_selector { left: 8px; }
#currency_selector { left: 96px; }
#sell_currency_selector { left: 52px; }
.arrow { width: 16px; height: 18px; }
.arrow-label { font-weight: bold; }
.arrow-prev { left: 0; top: 0; }
.arrow-next { left: 70px; top: 0; }
.selector-value { left: 16px; top: 3px; color: token(accent-gold); }

/* The search row: the name field on a dark well with its hint while empty, and the quality. */
#search_back {
	display: block;
	position: absolute;
	left: 8px;
	top: 86px;
	width: 86px;
	height: 18px;
	background-color: token(surface-recessed);
	border: 1px token(border-frame);
}
#search_field {
	text-align: left;
	left: 11px;
	top: 89px;
	padding: 0;
	border-width: 0;
	border-radius: 0;
	background-color: transparent;
	color: token(text-primary);
	pointer-events: auto;
}
#search_hint { left: 11px; top: 89px; text-align: left; color: token(text-muted); }
#quality_selector { left: 96px; top: 86px; }

#account_items { left: 0; top: 69px; color: token(text-primary); }

.rows {
	display: block;
	position: absolute;
	left: 8px;
	top: 108px;
	width: 174px;
	height: 230px;
	background-color: token(surface-recessed);
	border: 1px token(border-frame);
	border-radius: token(radius-sm)px;
}
.row {
	display: block;
	position: absolute;
	left: 1px;
	width: 172px;
	height: 38px;
	pointer-events: auto;
}
.row.clickable:hover { background-color: token(surface-raised); }
.row-name { left: 36px; top: 2px; text-align: left; color: token(text-primary); }
.row-price { left: 36px; top: 14px; text-align: left; font-weight: bold; color: token(accent-gold); }
.row-detail { left: 36px; top: 26px; text-align: left; color: token(text-muted); }
.row.mine .row-detail { color: #8cb4ff; }
.row.ended .row-detail { color: #ff7a6e; }
.row.pending .row-detail { color: #e0c060; }
.row:nth-child(1) { top: 1px; }
.row:nth-child(2) { top: 39px; }
.row:nth-child(3) { top: 77px; }
.row:nth-child(4) { top: 115px; }
.row:nth-child(5) { top: 153px; }
.row:nth-child(6) { top: 191px; }
#empty_text { left: 0; top: 120px; color: token(text-muted); }

.row-item { display: block; position: absolute; left: 12px; width: 32px; height: 32px; pointer-events: none; }
.row-item.hidden { visibility: hidden; }
#auction_item_0 { top: 112px; }
#auction_item_1 { top: 150px; }
#auction_item_2 { top: 188px; }
#auction_item_3 { top: 226px; }
#auction_item_4 { top: 264px; }
#auction_item_5 { top: 302px; }

#pager_prev { left: 40px; top: 344px; }
#pager_next { left: 134px; top: 344px; }
#pager_text { left: 56px; top: 347px; color: token(text-primary); }

#footer {
	left: 54px;
	top: 368px;
	--flow-w: 130px;
	line-height: 1.1;
	white-space: normal;
	word-break: break-word;
	color: token(text-muted);
}

#zen_to_claim { left: 54px; top: 368px; color: token(accent-gold); }
#btn_claim { left: 118px; top: 386px; width: 64px; height: 28px; }

/* Lengths inside counter-scaled layers: reference px times the panel's --root-scale. */
#title { width: calc(160px * var(--root-scale)); }
.tab-label { width: calc(53px * var(--root-scale)); }
.arrow-label { width: calc(16px * var(--root-scale)); }
.selector-value { width: calc(54px * var(--root-scale)); }
#account_items { width: calc(190px * var(--root-scale)); }
#search_field { width: calc(80px * var(--root-scale)); height: calc(13px * var(--root-scale)); line-height: calc(13px * var(--root-scale)); }
#search_hint { width: calc(80px * var(--root-scale)); }
.row-name, .row-price, .row-detail { width: calc(134px * var(--root-scale)); }
#empty_text { width: calc(174px * var(--root-scale)); }
#pager_text { width: calc(78px * var(--root-scale)); }
#zen_to_claim { width: calc(128px * var(--root-scale)); }
.claim-label { width: calc(64px * var(--root-scale)); }
