/* Modern theme for CJewelBankWindow: docked_panel_frame.rcss's forged panel (linked first), the
   list on a recessed well with the selected jewel in the accent, the buttons as modern buttons,
   locked ones dimmed. Geometry is the legacy one (reference px under the dock transform). */

#panel { pointer-events: auto; }

.sharp-text { display: block; position: absolute; white-space: nowrap; text-align: center; pointer-events: none; }

#title { left: 15px; top: 13px; font-weight: bold; color: token(text-warm); }
.fee { left: 0; color: token(text-primary); }
#jb_deposit_fee { top: 40px; }
#jb_withdrawal_fee { top: 54px; }

.rows {
	display: block;
	position: absolute;
	left: 8px;
	top: 72px;
	width: 174px;
	height: 194px;
	background-color: token(surface-recessed);
	border: 1px token(border-frame);
	border-radius: token(radius-sm)px;
}
.row {
	display: block;
	position: absolute;
	left: 1px;
	width: 172px;
	height: 19px;
	pointer-events: auto;
}
.row:hover { background-color: token(surface-raised); }
.row.selected { background-color: token(surface-raised); border: 1px token(accent-steel-hover); }
.row-name { left: 4px; top: 3px; text-align: left; color: token(text-primary); }
.row-amount { left: 112px; top: 3px; text-align: right; font-weight: bold; color: token(accent-gold); }
.row.empty .row-name, .row.empty .row-amount { color: token(text-muted); font-weight: normal; }
/* The jewel's icon right after its name; left comes from the window (the drawn name's width). */
.row-icon { display: block; position: absolute; top: 1px; width: 16px; height: 16px; pointer-events: none; }
.row.empty .row-icon { opacity: 0.45; }
.row:nth-child(1) { top: 1px; }
.row:nth-child(2) { top: 20px; }
.row:nth-child(3) { top: 39px; }
.row:nth-child(4) { top: 58px; }
.row:nth-child(5) { top: 77px; }
.row:nth-child(6) { top: 96px; }
.row:nth-child(7) { top: 115px; }
.row:nth-child(8) { top: 134px; }
.row:nth-child(9) { top: 153px; }
.row:nth-child(10) { top: 172px; }

.jb-btn {
	display: block;
	position: absolute;
	background-color: token(surface-raised);
	border: 1px token(border-frame);
	border-radius: token(radius-sm)px;
	pointer-events: auto;
}
.jb-btn:hover { border-color: token(accent-steel-hover); }
.btn-label { left: 0; color: token(text-primary); }
.jb-btn.locked, .jb-btn.locked:hover { background-color: token(surface-recessed); border-color: token(border-frame); }
.jb-btn.locked .btn-label { color: token(text-muted); }

#btn_keep { left: 8px; top: 272px; width: 64px; height: 28px; }
#btn_keep_all { left: 76px; top: 272px; width: 108px; height: 28px; }

#jb_withdraw_title { left: 0; top: 310px; color: token(text-primary); }
.withdraw-buttons { position: static; }
.withdraw-btn { top: 326px; width: 53px; height: 22px; background-color: token(surface-recessed); }
.withdraw-btn:hover { border-color: token(border-frame); }
.withdraw-btn.enabled { background-color: token(surface-raised); }
.withdraw-btn.enabled:hover { border-color: token(accent-steel-hover); }
.withdraw-btn .btn-label { font-weight: bold; color: token(text-muted); }
.withdraw-btn.enabled .btn-label { color: token(text-primary); }
.withdraw-btn:nth-child(1) { left: 10px; }
.withdraw-btn:nth-child(2) { left: 68px; }
.withdraw-btn:nth-child(3) { left: 126px; }

#jb_hint {
	left: 6px;
	top: 362px;
	--flow-w: 178px;
	line-height: 1.1;
	white-space: normal;
	word-break: break-word;
	color: token(text-muted);
}

/* Lengths inside counter-scaled layers: reference px times the panel's --root-scale. */
#title { width: calc(160px * var(--root-scale)); }
.fee { width: calc(190px * var(--root-scale)); }
.row-name { width: calc(108px * var(--root-scale)); }
.row-amount { width: calc(56px * var(--root-scale)); }
.keep-label { width: calc(64px * var(--root-scale)); }
.keep-all-label { width: calc(108px * var(--root-scale)); }
#jb_withdraw_title { width: calc(190px * var(--root-scale)); }
.withdraw-label { width: calc(53px * var(--root-scale)); }
