/* Legacy theme for CJewelBankWindow: the docked_panel_frame.rcss frame (linked first;
   newui_item_back01 top), the title bold, the fees, the list of jewels on a dark well (the selected
   one framed in the gold of the original's gauges, the empty ones grey), Keep and Keep all on the
   64 x 29 newui_btn_empty_small and the 108 x 29 newui_btn_empty, the withdrawals on the 53 x 23
   newui_btn_empty_very_small (up / over / down rows), a locked button tinted (100, 100, 100) with
   a grey label, then the hint. Coordinates are reference px inside #panel. */

@spritesheet jb-btn-small-sheet
{
	src: "../../../newui_btn_empty_small.tga";
	jb-btn-small-up: 0px 0px 64px 29px;
	jb-btn-small-over: 0px 29px 64px 29px;
	jb-btn-small-down: 0px 58px 64px 29px;
}
@spritesheet jb-btn-wide-sheet
{
	src: "../../../newui_btn_empty.tga";
	jb-btn-wide-up: 0px 0px 108px 29px;
	jb-btn-wide-over: 0px 29px 108px 29px;
	jb-btn-wide-down: 0px 58px 108px 29px;
}
@spritesheet jb-btn-tiny-sheet
{
	src: "../../../newui_btn_empty_very_small.tga";
	jb-btn-tiny-up: 0px 0px 53px 23px;
	jb-btn-tiny-over: 0px 23px 53px 23px;
	jb-btn-tiny-down: 0px 46px 53px 23px;
}

.frame-top { decorator: image(docked-bg-top-b); }
#panel { pointer-events: auto; }

.sharp-text { display: block; position: absolute; white-space: nowrap; text-align: center; pointer-events: none; }

#title { left: 15px; top: 13px; font-weight: bold; color: #dcdcdc; }
.fee { left: 0; color: #dcdcdc; }
#jb_deposit_fee { top: 40px; }
#jb_withdrawal_fee { top: 54px; }

/* The list: ten rows of 21 units from y 73 on a dark well, each jewel's icon at its left. */
.rows {
	display: block;
	position: absolute;
	left: 8px;
	top: 72px;
	width: 174px;
	height: 212px;
	background-color: #0b0b0bc0;
	border: 1px #5a4a2a;
}
.row {
	display: block;
	position: absolute;
	left: 1px;
	width: 172px;
	height: 21px;
	pointer-events: auto;
}
.row:hover { background-color: #ffffff1a; }
.row.selected { background-color: #c8961e40; }
.row-name { left: 25px; top: 4px; text-align: left; color: #ffffff; }
.row-amount { left: 116px; top: 4px; text-align: right; font-weight: bold; color: #ffd24a; }
.row.empty .row-name { color: #a0a0a0; }
.row.empty .row-amount { color: #808080; font-weight: normal; }
/* The jewel's icon in a column at the left of its row. */
.row-icon { display: block; position: absolute; left: 3px; top: 1px; width: 19px; height: 19px; pointer-events: none; }
.row.empty .row-icon { opacity: 0.45; }
.row:nth-child(1) { top: 1px; }
.row:nth-child(2) { top: 22px; }
.row:nth-child(3) { top: 43px; }
.row:nth-child(4) { top: 64px; }
.row:nth-child(5) { top: 85px; }
.row:nth-child(6) { top: 106px; }
.row:nth-child(7) { top: 127px; }
.row:nth-child(8) { top: 148px; }
.row:nth-child(9) { top: 169px; }
.row:nth-child(10) { top: 190px; }

.jb-btn { display: block; position: absolute; pointer-events: auto; }
.btn-label { left: 0; color: #ffffff; }

#btn_keep { left: 8px; top: 290px; width: 64px; height: 29px; decorator: image(jb-btn-small-up); }
#btn_keep:hover { decorator: image(jb-btn-small-over); }
#btn_keep:active { decorator: image(jb-btn-small-down); }
#btn_keep_all { left: 76px; top: 290px; width: 108px; height: 29px; decorator: image(jb-btn-wide-up); }
#btn_keep_all:hover { decorator: image(jb-btn-wide-over); }
#btn_keep_all:active { decorator: image(jb-btn-wide-down); }
/* CButton::Lock(): the up frame, grey, no hover. */
#btn_keep.locked, #btn_keep.locked:hover, #btn_keep.locked:active { decorator: image(jb-btn-small-up); image-color: #646464; }
#btn_keep_all.locked, #btn_keep_all.locked:hover, #btn_keep_all.locked:active { decorator: image(jb-btn-wide-up); image-color: #646464; }
.jb-btn.locked .btn-label { color: #808080; }

#jb_withdraw_title { left: 0; top: 326px; color: #dcdcdc; }
.withdraw-buttons { position: static; }
.withdraw-btn { top: 342px; width: 53px; height: 23px; decorator: image(jb-btn-tiny-up); image-color: #646464; }
.withdraw-btn.enabled { image-color: #ffffff; }
.withdraw-btn.enabled:hover { decorator: image(jb-btn-tiny-over); }
.withdraw-btn.enabled:active { decorator: image(jb-btn-tiny-down); }
.withdraw-btn .btn-label { font-weight: bold; color: #808080; }
.withdraw-btn.enabled .btn-label { color: #ffffff; }
.withdraw-btn:nth-child(1) { left: 10px; }
.withdraw-btn:nth-child(2) { left: 68px; }
.withdraw-btn:nth-child(3) { left: 126px; }

#jb_hint {
	left: 6px;
	top: 374px;
	--flow-w: 178px;
	line-height: 1.1;
	white-space: normal;
	word-break: break-word;
	color: #969696;
}

/* Lengths inside counter-scaled layers: reference px times the panel's --root-scale. */
#title { width: calc(160px * var(--root-scale)); }
.fee { width: calc(190px * var(--root-scale)); }
.row-name { width: calc(88px * var(--root-scale)); }
.row-amount { width: calc(52px * var(--root-scale)); }
.keep-label { width: calc(64px * var(--root-scale)); }
.keep-all-label { width: calc(108px * var(--root-scale)); }
#jb_withdraw_title { width: calc(190px * var(--root-scale)); }
.withdraw-label { width: calc(53px * var(--root-scale)); }
